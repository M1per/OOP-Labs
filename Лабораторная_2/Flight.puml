@startuml

title UML-диаграмма классов Flight и Aircraft

class Aircraft {
    - model : string
    - capacity : int

    + Aircraft()
    + Aircraft(model : string, capacity : int)

    + getModel() : string
    + getCapacity() : int
}

class Flight {
    - flightNumber : int
    - destination : string
    - aircraft : Aircraft
    - passengerCount : int
    - status : FlightStatus
    - objectCount : int {static}

    + Flight()
    + Flight(number : int, destination : string, aircraft : Aircraft)
    + Flight(number : int, destination : string, aircraft : Aircraft, passengers : int, status : FlightStatus)
    + ~Flight()

    + getFlightNumber() : int
    + getDestination() : string
    + getAircraft() : Aircraft
    + getCapacity() : int
    + getPassengerCount() : int
    + getStatus() : FlightStatus

    + addPassenger() : bool
    + removePassenger() : bool
    + changeStatus(newStatus : FlightStatus) : void
    + printInfo() : void
    + getObjectCount() : int {static}
}

enum FlightStatus {
    Scheduled
    Registration
    Departed
    Completed
    Cancelled
}

Flight *-- Aircraft
Flight --> FlightStatus

@enduml