@startuml
title Лабораторная работа № 3 — Расписание на день

skinparam classAttributeIconSize 0
skinparam shadowing false

class Time {
    - totalSeconds : int
    - accessCount : unsigned int
    {static} - objectCount : int

    - {static} normalize(seconds : int) : int

    + Time()
    + explicit Time(seconds : int)
    + Time(hours : int, minutes : int, seconds : int)
    + Time(other : const Time&)
    + operator=(other : const Time&) : Time&
    + ~Time()

    + getHours() : int
    + getMinutes() : int
    + getSeconds() : int
    + getTotalSeconds() : int
    + getAccessCount() : unsigned int
    + toString() : string

    + operator++() : Time&
    + operator++(int) : Time
    + operator--() : Time&
    + operator--(int) : Time

    + operator+=(other : const Time&) : Time&
    + operator-=(other : const Time&) : Time&
    + operator*=(other : const Time&) : Time&
    + operator/=(other : const Time&) : Time&

    + operator+(lhs : Time, rhs : const Time&) : Time
    + operator-(lhs : Time, rhs : const Time&) : Time
    + operator*(lhs : Time, rhs : const Time&) : Time
    + operator/(lhs : Time, rhs : const Time&) : Time

    + operator<(other : const Time&) : bool
    + operator>(other : const Time&) : bool
    + operator<=(other : const Time&) : bool
    + operator>=(other : const Time&) : bool
    + operator==(other : const Time&) : bool
    + operator!=(other : const Time&) : bool

    + {static} getObjectCount() : int
}

class Event <<struct>> {
    + name : string
    + start : Time
    + end : Time
}

package "main.cpp — управление расписанием" {
    class "Функции меню" as Menu {
        + showSchedule() : void
        + addEvent() : void
        + changeEvent() : void
        + compareTimes() : void
        + demonstrateOperators() : void
        + showStatistics() : void
    }
}

Event *-- Time : начало и окончание
Menu ..> Event : управляет событиями
Menu ..> Time : использует время

note right of Time
  Время хранится в секундах
  и отображается как HH:MM:SS.

  Арифметические операции
  используют составные операторы.

  explicit запрещает неявное
  преобразование int в Time.

  mutable позволяет изменять
  accessCount в const-методах.
end note

@enduml
